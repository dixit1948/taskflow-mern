NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=taskflow
# long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_DAYS=7
# comma separated list of frontend URLs allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
# use "none" only when frontend and backend are on different domains (needs HTTPS)
COOKIE_SAMESITE=lax
# reverse proxies in front of the API: 1 on Render/Railway alone, 2 if the frontend host (e.g. Vercel) proxies /api to it
TRUST_PROXY=1
